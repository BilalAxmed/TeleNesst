#define IDI_APPICON 1

IDI_APPICON ICON "../../TeleNest.ico"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TeleNest ICT Enterprise"
            VALUE "FileDescription", "TeleNest - Warehouse & ICT Operations Management"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "TeleNest"
            VALUE "LegalCopyright", "Copyright (C) 2026 Bilal Ahmed"
            VALUE "OriginalFilename", "TeleNest.exe"
            VALUE "ProductName", "TeleNest ICT Management System"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
